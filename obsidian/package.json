{
  "name": "soohyuk-blog-frontmatter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs && npm run verify:build",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "licenses": "node scripts/licenses.mjs --write",
    "verify:licenses": "node scripts/licenses.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:blog-compat": "node --test tests/compatibility/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
